{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "initial-version": "0.1.0",
      "release-type": "go"
    },
    "packages/vider": {
      "initial-version": "0.1.0",
      "release-type": "node",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/darwin-arm64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/darwin-x64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/linux-arm64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/linux-x64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/win32-x64']"
        }
      ]
    }
  }
}
