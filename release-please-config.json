{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "vider",
      "components": ["vider", "vider-node"]
    }
  ],
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "vider",
      "component": "vider",
      "include-component-in-tag": false,
      "initial-version": "0.1.0"
    },
    "packages/vider": {
      "release-type": "node",
      "package-name": "@vider-app/vider",
      "component": "vider-node",
      "include-component-in-tag": true,
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/darwin-arm64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/darwin-x64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/linux-arm64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/linux-x64']"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.optionalDependencies['@vider-app/win32-x64']"
        }
      ]
    }
  }
}
